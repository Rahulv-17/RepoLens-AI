PORT=5000

# ⚠️  REQUIRED: Replace with your MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/repolens?retryWrites=true&w=majority

# ⚠️  REQUIRED: Replace with a long random secret for signing JWTs
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars

# ⚠️  REQUIRED: Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
